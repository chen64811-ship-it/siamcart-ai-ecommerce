# SiamCart — environment template
#
# Copy this file to .env and fill in your values:
#   Windows:  copy .env.example .env
#   Linux/macOS:  cp .env.example .env
#
# DEEPSEEK_ENABLED=false by default — the app runs fully deterministically
# without an LLM. Set to "true" (and provide an API key) to enable natural
# Thai LLM formatting on top of the deterministic pipeline.
#
# NEVER commit a real .env file. Only this template is versioned.

# ── DeepSeek LLM formatter (optional) ─────────────────────────────────
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=8
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Embedding model for policy RAG (optional) ─────────────────────────
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Paths (relative to the project root) ──────────────────────────────
# STORE_DB_PATH=data/orders.db
# CHROMA_DIR=data/chroma
# POLICY_DOCS_DIR=data/policies

# ── Server (used when starting uvicorn manually) ──────────────────────
# APP_HOST=0.0.0.0
# APP_PORT=8000
